{
	"name": "pi-policy-core",
	"version": "0.1.0",
	"description": "Shared engine for Pi command-policy extensions: segment splitting, effective-directory tracking, path scoping, policy loading with user overrides, and a fail-closed tool_call handler.",
	"license": "MIT",
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": "./src/index.ts"
	},
	"files": [
		"src/",
		"tests/",
		"README.md"
	],
	"scripts": {
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"test": "node --test --experimental-strip-types \"tests/**/*.test.ts\"",
		"test:bun": "bun test tests/"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "^1.3.0",
		"typescript": "^5.6.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
