{
	"name": "pi-git-policy",
	"version": "0.1.0",
	"description": "Locks commits and pushes to protected branches, and blocks dangerous git operations.",
	"license": "MIT",
	"type": "module",
	"main": "./src/extension.ts",
	"types": "./src/extension.ts",
	"exports": {
		".": "./src/extension.ts"
	},
	"files": [
		"src/",
		"policies/",
		"tests/",
		"README.md"
	],
	"pi": {
		"extensions": [
			"./src/extension.ts"
		]
	},
	"scripts": {
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"test": "node --test --experimental-strip-types \"tests/**/*.test.ts\""
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "^1.3.0",
		"typescript": "^5.6.0"
	},
	"dependencies": {
		"pi-policy-core": "^0.1.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
